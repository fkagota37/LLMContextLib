{
  "name": "llmcontextlib-port-typescript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Experimental TypeScript port of LLMContextLib.",
  "exports": {
    ".": "./src/index.ts",
    "./adapter-support": "./src/adapter-support.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "build:packages": "tsc -p tsconfig.packages.json && node scripts\\pack.mjs",
    "test:packages": "node tests\\reference\\verify-packages.mjs",
    "test": "vitest run",
    "check": "npm run build && npm run test",
    "example:build-investigation": "tsx examples\\BuildInvestigation\\program.ts",
    "format": "prettier --check .",
    "lint": "eslint . --ext .ts"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.46.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
