<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>felix kagota</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Experimental work in progress; not production-ready. No stable, versioned release or compatibility guarantees.</PackageReleaseNotes>
    <Description>Segmented in-memory LLM sessions, contextual navigation and scoped memory views.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LLMContextLib.Tests" />
    <InternalsVisibleTo Include="LLMContextLib.Benchmarks" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
