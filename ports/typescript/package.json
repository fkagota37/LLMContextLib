{
  "name": "llmcontextlib-port-typescript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bootstrap project for the TypeScript port of LLMContextLib.",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run build && npm run test",
    "format": "prettier --check .",
    "lint": "eslint . --ext .ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
